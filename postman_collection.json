{
  "info": {
    "name": "Restaurant Management Backend - Sqrock Task 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5002/api" },
    { "key": "adminToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "menuItemId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Signup - Customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ejlal Shah\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\"\n}" },
        "url": "{{baseUrl}}/auth/signup"
      }
    },
    {
      "name": "Login - Admin (after running npm run create-admin)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@restaurant.com\",\n  \"password\": \"admin123456\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login - Customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Add Menu Item (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Chicken Shawarma\",\n  \"category\": \"Main Course\",\n  \"price\": 25,\n  \"description\": \"Grilled chicken wrap with garlic sauce\",\n  \"isAvailable\": true\n}" },
        "url": "{{baseUrl}}/menu"
      }
    },
    { "name": "Get Menu (Public)", "request": { "method": "GET", "url": "{{baseUrl}}/menu" } },
    { "name": "Search Menu by Category", "request": { "method": "GET", "url": "{{baseUrl}}/menu?category=Main Course" } },
    {
      "name": "Update Menu Item (Admin)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"price\": 28,\n  \"isAvailable\": false\n}" },
        "url": "{{baseUrl}}/menu/{{menuItemId}}"
      }
    },
    {
      "name": "Delete Menu Item (Admin)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/menu/{{menuItemId}}"
      }
    },
    {
      "name": "Place Order (Customer)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"menuItemId\": \"{{menuItemId}}\", \"quantity\": 2 }\n  ]\n}" },
        "url": "{{baseUrl}}/order"
      }
    },
    {
      "name": "My Orders (Customer)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
        "url": "{{baseUrl}}/my-orders"
      }
    },
    {
      "name": "All Orders (Admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/orders"
      }
    },
    {
      "name": "Update Order Status (Admin)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"Preparing\"\n}" },
        "url": "{{baseUrl}}/order/{{orderId}}/status"
      }
    }
  ]
}
